# Copy this file to your shell environment or to a local .env file.
# Do not commit real secrets or machine-specific .env files.

# Local-only container settings. Replace these values for your own machine.
POSTGRES_DB=opledger
POSTGRES_USER=opledger
POSTGRES_PASSWORD=replace-with-local-only-password
POSTGRES_PORT=55432
REDIS_PORT=56379

# Host port for the FastAPI container.
API_PORT=18080
REPORTING_PORT=18081

# Optional readiness tuning for local experiments.
OPLEDGER_DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Optional metrics protection. Leave empty for local-only development. Set a
# real token when /metrics could be reached through a public proxy or ingress.
OPLEDGER_METRICS_ACCESS_TOKEN=

# Optional local-only report latency experiment. Leave disabled by default.
OPLEDGER_REPORT_DELAY_ENABLED=false
OPLEDGER_REPORT_MAX_DELAY_SECONDS=5

# Redis is used only for local queued work transport in Phase 2.
OPLEDGER_REDIS_URL=redis://localhost:56379/0
OPLEDGER_REPORT_QUEUE_NAME=reports
OPLEDGER_DASHBOARD_CUSTOMER_WORK_REQUEST_STATS_CACHE_TTL_SECONDS=30
OPLEDGER_REPORT_JOB_MAX_ATTEMPTS=3
OPLEDGER_REPORT_JOB_RETRY_BACKOFF_SECONDS=1,5

# Optional local/test-only report worker failure injection. Leave disabled by default.
OPLEDGER_REPORT_FAILURE_INJECTION_ENABLED=false
OPLEDGER_REPORT_FAILURE_INJECTION_STAGE=none

# Optional extracted report-rendering service. Leave empty for in-process local
# rendering outside Compose; Compose sets the worker URL to the reporting service.
OPLEDGER_REPORT_RENDERING_SERVICE_URL=
OPLEDGER_REPORT_RENDERING_SERVICE_TIMEOUT_SECONDS=2

# Optional local/test-only reporting service failure injection. Leave disabled
# by default. Modes: none, delay, http_500, malformed_response,
# incompatible_response.
OPLEDGER_REPORTING_FAILURE_INJECTION_ENABLED=false
OPLEDGER_REPORTING_FAILURE_MODE=none
OPLEDGER_REPORTING_FAILURE_DELAY_SECONDS=0

# Local fake notifications write durable attempts and logs only.
# No external email, SMS, Slack, or paid provider is configured.
